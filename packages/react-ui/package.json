{
  "name": "@resolid/react-ui",
  "version": "0.3.8",
  "private": false,
  "description": "A React design system built with Tailwind CSS, offering ready-to-use components for consistent UI.",
  "keywords": [
    "react",
    "react-hook",
    "resolid",
    "tailwindcss"
  ],
  "homepage": "https://ui.resolid.tech",
  "license": "MIT",
  "author": "Huijie Wei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resolid/react-ui.git",
    "directory": "packages/react-ui"
  },
  "files": [
    "dist",
    "tailwindcss"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "import": "./dist/locales/*.js"
    },
    "./tailwindcss": "./tailwindcss/index.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@resolid/utils": "^2.0.0",
    "@tanstack/react-virtual": "^3.14.26",
    "tailwind-variants": "^4.0.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@rolldown/plugin-babel": "^0.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/pretty-format": "^5.1.0",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  }
}
